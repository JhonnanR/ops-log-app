# Notion integration token — create a NEW internal integration in Notion
# (separate from the Field Timesheet App's integration), and share it with
# Project DB, Buildings DB, and Elevations DB only.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data source IDs (the collection:// id, not the page id) for each DB.
# You can get these from the "fetch" output on each database, or from the
# database's URL when viewing it in Notion as a full page.
NOTION_PROJECTS_DB=dbad50c3-dbdd-44a0-9b4b-0d3ba17966ca
NOTION_BUILDINGS_DB=83ad2c2a-2ef0-4438-a9ea-09ff342b57ac
NOTION_ELEVATIONS_DB=3d675b2d-077e-80f6-8f62-000b28148e60
